library(patchwork)
library(pheatmap)
scale_per_cluster <- function(df, markers) {
df %>%
group_by(cluster) %>%
mutate(
across(
all_of(markers),
list(
zscore = ~ scale(.x)[, 1],                          # klasyczny z-score
robust = ~ (.x - median(.x)) / (IQR(.x) + 1e-9)    # robust z-score (IQR, epsilon żeby uniknąć /0)
),
.names = "{.col}__{.fn}"
)
) %>%
ungroup()
}
df_scaled <- scale_per_cluster(df_full, marker_cols_13)
