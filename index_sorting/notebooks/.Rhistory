# dev.off()
marker_cols_13 <- grep("_Median$", colnames(df), value = TRUE)
df[marker_cols_13] <- lapply(df[marker_cols_13], function(x) {
as.numeric(gsub(",", ".", x))
})
df_log_13 <- df
df_log_13[marker_cols_13] <- log10(df[marker_cols_13])
df_scaled_13 <- df_log_13
df_scaled_13[marker_cols_13] <- scale(df_log_13[marker_cols_13])
num_cols <- sapply(df_scaled_13, is.numeric)
df_scaled_13[, num_cols] <- lapply(df_scaled_13[, num_cols], function(x) {
x[is.na(x) | is.infinite(x)] <- 0
x
})
umap_full <- umap_df %>%
bind_cols(df_scaled_13 %>% select(ends_with("_Median")))
plot_long <- umap_full %>%
pivot_longer(cols = ends_with("_Median"),
names_to = "Marker",
values_to = "Z_Score")
#png("umap_13_index_v2.png", width = 1500, height = 1000)
ggplot(plot_long, aes(x = UMAP1, y = UMAP2, color = Z_Score)) +
geom_point(size = 0.8, alpha = 0.6) +
facet_wrap(~Marker, ncol = 4) +
scale_color_gradient2(low = "blue", mid = "white", high = "red") +
theme_minimal() +
labs(title = "Ekspresja markerów index (Z-score) na UMAP z bramek",
color = "Z-score")
